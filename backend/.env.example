# Copy this file to ".env" and fill in your values
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/fixmate?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-long-random-string
# DEMO_OTP=true returns the OTP in the API response (for testing without an SMS gateway).
# Set to false in production and plug in a real SMS provider (MSG91 / Twilio / Firebase).
DEMO_OTP=true

# Firebase Admin (verifies the Firebase Phone Auth ID token on /api/auth/firebase).
# Firebase console -> Project Settings -> Service accounts -> Generate new private key,
# then save the JSON file as backend/serviceAccountKey.json (keep it private, never commit it).
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
